int squared(int n) { return n*n; }

int add(int left, int right) { return left+right; }

int sum_to(int n) {
	int previous;
	if (n > 1) {
		previous=n-1;
		return n+sum_to(previous);
	}
	else return n;
}

int bump(int value) {
	int result;
	result = value+1;
	return result;
}

int set_first(int items[], int value) {
	items[0] = value;
	return items[0];
}

